<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Owner admin — WhatsApp Marketing</title>
<link rel="stylesheet" href="/styles.css" />
<style>
  .authwrap { max-width: 420px; margin: 8vh auto; padding: 24px; }
  .authwrap label { display: block; margin: 12px 0 4px; }
  .authwrap input { width: 100%; box-sizing: border-box; }
  .authwrap button.primary { width: 100%; margin-top: 16px; }
  .statgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 12px 0; }
  .stat { background: #15202b; border: 1px solid #2a3a4a; border-radius: 10px; padding: 12px; }
  .stat .num { font-size: 26px; font-weight: 700; }
  .stat .lbl { color: #9fb3c8; font-size: 12px; }
  .pill.suspended { background: #b4232a; }
  .pill.past_due { background: #b7791f; }
  .pill.pending_payment { background: #6a4fb3; }
  .flagged { color: #ffb020; font-weight: 700; }
  .tablewrap { overflow-x: auto; }
  #announceText { width: 100%; box-sizing: border-box; min-height: 60px; }
</style>
</head>
<body>

<!-- Login view -->
<div id="loginView" class="authwrap card" style="display:none">
  <h1>Owner admin</h1>
  <p class="subtitle">Restricted area.</p>
  <form id="adminLoginForm">
    <label>Email<br /><input id="email" type="email" required autocomplete="username" /></label>
    <label>Password<br /><input id="password" type="password" required autocomplete="current-password" /></label>
    <p id="loginMsg" class="error"></p>
    <button class="primary" type="submit">Log in</button>
  </form>
</div>

<!-- Dashboard view -->
<div id="dashView" style="display:none">
  <header class="topbar">
    <div>
      <h1>Owner admin</h1>
      <p class="subtitle">Users, subscriptions, platform health.</p>
    </div>
    <div class="tokenbox">
      <span id="adminEmail" class="muted"></span>
      <button id="logoutBtn">Log out</button>
    </div>
  </header>
  <main>
    <div class="statgrid" id="statGrid"></div>

    <div class="card">
      <h3>Announcement banner</h3>
      <p class="muted">Shown to every logged-in user as a dismissible banner. Empty = no banner.</p>
      <textarea id="announceText" maxlength="500" placeholder="e.g. Scheduled maintenance Sunday 2am–4am GMT…"></textarea>
      <div class="row">
        <button id="saveAnnounceBtn" class="primary">Save banner</button>
        <button id="clearAnnounceBtn">Clear</button>
        <span id="announceMsg" class="muted"></span>
      </div>
    </div>

    <div class="card">
      <h3>Users</h3>
      <div class="tablewrap">
        <table class="table" id="usersTable">
          <thead>
            <tr>
              <th>Email</th>
              <th>Status</th>
              <th>Period ends</th>
              <th>WhatsApp</th>
              <th>Contacts</th>
              <th>DMs 24h</th>
              <th></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[c]));

  async function api(path, opts = {}) {
    const res = await fetch(path, {
      ...opts,
      headers: { "Content-Type": "application/json", ...(opts.headers || {}) }
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `Request failed (${res.status}).`);
    return data;
  }

  function showLogin() {
    $("loginView").style.display = "";
    $("dashView").style.display = "none";
  }

  function showDash(email) {
    $("loginView").style.display = "none";
    $("dashView").style.display = "";
    $("adminEmail").textContent = email;
    loadAll();
  }

  async function boot() {
    try {
      const me = await api("/api/admin/me");
      showDash(me.admin.email);
    } catch {
      showLogin();
    }
  }

  $("adminLoginForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    $("loginMsg").textContent = "";
    try {
      await api("/api/admin/login", {
        method: "POST",
        body: JSON.stringify({ email: $("email").value.trim(), password: $("password").value })
      });
      const me = await api("/api/admin/me");
      showDash(me.admin.email);
    } catch (err) {
      $("loginMsg").textContent = err.message;
    }
  });

  $("logoutBtn").addEventListener("click", async () => {
    await api("/api/admin/logout", { method: "POST" }).catch(() => {});
    showLogin();
  });

  function pill(status) {
    const cls = status === "active" ? "pill ok"
      : status === "suspended" ? "pill suspended"
      : status === "past_due" ? "pill past_due"
      : status === "pending_payment" ? "pill pending_payment" : "pill";
    return `<span class="${cls}">${esc(status)}</span>`;
  }

  function fmtDate(iso) {
    if (!iso) return "—";
    try { return new Date(iso).toLocaleDateString(); } catch { return "—"; }
  }

  async function loadAll() {
    try {
      const [stats, users, ann] = await Promise.all([
        api("/api/admin/stats"),
        api("/api/admin/users"),
        api("/api/admin/announcement")
      ]);
      $("statGrid").innerHTML = `
        <div class="stat"><div class="num">${stats.users}</div><div class="lbl">Users</div></div>
        <div class="stat"><div class="num">${stats.active}</div><div class="lbl">Active</div></div>
        <div class="stat"><div class="num">${stats.past_due}</div><div class="lbl">Past due</div></div>
        <div class="stat"><div class="num">${stats.suspended}</div><div class="lbl">Suspended</div></div>
        <div class="stat"><div class="num">${stats.pending_payment}</div><div class="lbl">Unpaid</div></div>
        <div class="stat"><div class="num">₵${stats.mrr.toFixed(2)}</div><div class="lbl">Est. MRR</div></div>
        <div class="stat"><div class="num">${stats.dms24h}</div><div class="lbl">DMs last 24h</div></div>
        <div class="stat"><div class="num">${stats.flagged}</div><div class="lbl">Flagged ⚠</div></div>`;
      const tb = document.querySelector("#usersTable tbody");
      tb.innerHTML = "";
      for (const u of users.users) {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${esc(u.email)}${u.flagged ? ' <span class="flagged">⚠</span>' : ""}<br />
            <span class="muted">${esc(u.id.slice(0, 8))}… · since ${fmtDate(u.createdAt)}</span></td>
          <td>${pill(u.subscription.status)}</td>
          <td>${fmtDate(u.subscription.currentPeriodEnd)}<br />
            <span class="muted">${u.subscription.period || "—"}</span></td>
          <td>${u.whatsapp.connected
            ? `<span class="pill ok">✓ ${esc(u.whatsapp.number || "linked")}</span>`
            : `<span class="muted">—</span>`}</td>
          <td>${u.counts.contacts}</td>
          <td>${u.counts.dms24h}</td>
          <td></td>`;
        const actions = tr.lastElementChild;
        if (u.subscription.status === "suspended") {
          const b = document.createElement("button");
          b.textContent = "Unsuspend";
          b.onclick = () => act(u, "unsuspend");
          actions.appendChild(b);
        } else {
          const b = document.createElement("button");
          b.textContent = "Suspend";
          b.className = "danger";
          b.onclick = () => {
            if (confirm(`Suspend ${u.email}? Their WhatsApp will disconnect immediately.`)) act(u, "suspend");
          };
          actions.appendChild(b);
        }
        const e = document.createElement("button");
        e.textContent = "Extend…";
        e.style.marginLeft = "6px";
        e.onclick = () => {
          const days = prompt(`Extend ${u.email} by how many days? (1–365)`, "30");
          if (days !== null) act(u, "extend", { days: Number(days) });
        };
        actions.appendChild(e);
        tb.appendChild(tr);
      }
      $("announceText").value = ann.text || "";
    } catch (err) {
      if (/401/.test(err.message)) showLogin();
    }
  }

  async function act(u, action, body) {
    try {
      await api(`/api/admin/users/${u.id}/${action}`, { method: "POST", body: JSON.stringify(body || {}) });
      loadAll();
    } catch (err) {
      alert(err.message);
    }
  }

  $("saveAnnounceBtn").addEventListener("click", async () => {
    $("announceMsg").textContent = "";
    try {
      await api("/api/admin/announcement", {
        method: "POST",
        body: JSON.stringify({ text: $("announceText").value.trim() })
      });
      $("announceMsg").textContent = "Saved — users will see it on next load.";
    } catch (err) {
      $("announceMsg").textContent = err.message;
    }
  });

  $("clearAnnounceBtn").addEventListener("click", async () => {
    $("announceMsg").textContent = "";
    try {
      await api("/api/admin/announcement", { method: "POST", body: JSON.stringify({ text: "" }) });
      $("announceText").value = "";
      $("announceMsg").textContent = "Cleared.";
    } catch (err) {
      $("announceMsg").textContent = err.message;
    }
  });

  boot();
</script>
</body>
</html>
